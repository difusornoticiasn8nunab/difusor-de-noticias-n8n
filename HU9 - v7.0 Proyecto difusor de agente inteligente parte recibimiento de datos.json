    {
      "parameters": {
        "jsCode": "// Función estándar de JavaScript para generar un UUID/GUID\nconst generateUUID = () => {\n    return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, (c) => {\n        const r = (Math.random() * 16) | 0;\n        const v = c === 'x' ? r : (r & 0x3) | 0x8;\n        return v.toString(16);\n    });\n};\n\n\nfor (const item of items) {\n    // 1. GENERACIÓN DEL ID ÚNICO\n    item.json.idFila = generateUUID(); \n\n    // 2. CÓDIGO DE FECHA Y HORA\n    const nowInChile = new Date(Date.now() - (3 * 60 * 60 * 1000)); \n\n    const year = nowInChile.getFullYear();\n    const month = String(nowInChile.getMonth() + 1).padStart(2, '0');\n    const day = String(nowInChile.getDate()).padStart(2, '0');\n    const hours = String(nowInChile.getHours()).padStart(2, '0');\n    const minutes = String(nowInChile.getMinutes()).padStart(2, '0');\n    const seconds = String(nowInChile.getSeconds()).padStart(2, '0');\n\n    // Asignación de la propiedad local de fecha y hora\n    item.json.fechaCreacionLocal = `${year}-${month}-${day} ${hours}:${minutes}:${seconds}`;\n\n\n    // 3. VALIDACIÓN Y PROCESAMIENTO DE BINARIOS\n    if (item.binary && Object.keys(item.binary).length > 0) {\n        \n        const binaryProperties = Object.keys(item.binary);\n        const binaryPropertyName = binaryProperties[0];\n        const binaryObject = item.binary[binaryPropertyName];\n\n        // Extracción de Metadata\n        item.json.archivoNombre = binaryObject.fileName;\n        item.json.archivoTipo = binaryObject.mimeType;\n        item.json.archivoSize = binaryObject.fileSize;\n\n        // Renombrar el objeto binario a 'archivo' para el ruteo del nodo Drive\n        item.binary.archivo = item.binary[binaryPropertyName];\n        delete item.binary[binaryPropertyName]; \n\n    } else {\n        // Fallback si NO hay archivo adjunto\n        item.json.archivoNombre = 'NoFile';\n        item.json.archivoTipo = 'N/A';\n        item.json.archivoSize = 0;\n        item.binary = {}; \n    }\n}\n// **************** FIN DEL BUCLE PRINCIPAL *****************\n\nreturn items;"
      },
